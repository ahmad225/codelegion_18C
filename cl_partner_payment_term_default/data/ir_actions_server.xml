<odoo>
    <!-- Actions menu on contacts, for invoicing users: put the selected
         contacts (and the contacts of the selected companies) back on the
         payment terms of their company. -->
    <record id="action_cl_sync_payment_terms" model="ir.actions.server">
        <field name="name">Apply Company Payment Terms</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_cl_sync_payment_terms()
        </field>
    </record>
</odoo>
