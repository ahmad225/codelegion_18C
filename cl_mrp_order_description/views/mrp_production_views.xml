<odoo>
    <record id="mrp_production_form_inherit_cl_description" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.cl.description</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- bom_id sits inside a row <div>: a field added right after it
                 would get no label, so anchor on the row itself. -->
            <xpath expr="//field[@name='bom_id']/parent::div" position="after">
                <field name="cl_mo_description"
                       placeholder="Instructions printed on the Production Order..."/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_filter_inherit_cl_description" model="ir.ui.view">
        <field name="name">mrp.production.search.inherit.cl.description</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="cl_mo_description"/>
            </xpath>
        </field>
    </record>
</odoo>
