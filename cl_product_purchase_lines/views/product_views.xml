<odoo>
    <!-- One list for the smart button action and for the tab of both product forms -->
    <record id="cl_incoming_po_line_list" model="ir.ui.view">
        <field name="name">purchase.order.line.list.cl.incoming</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Incoming Purchases" create="false" edit="false" delete="false"
                  no_open="1">
                <!-- no_open: a row is not a way into the purchase order line form
                     (which shows prices); Purchase users have the Open Order button -->
                <field name="order_id" string="Purchase Order"/>
                <field name="product_id" optional="hide"/>
                <field name="partner_id" string="Vendor"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="date_order" optional="hide"/>
                <field name="date_planned" string="Expected Arrival"/>
                <field name="product_qty" string="Ordered"/>
                <field name="qty_received" string="Received"/>
                <field name="cl_qty_to_receive"/>
                <field name="product_uom" groups="uom.group_uom" optional="show"/>
                <!-- Prices and the order itself are for Purchase users only -->
                <field name="currency_id" column_invisible="1"/>
                <field name="price_unit" groups="purchase.group_purchase_user" optional="hide"/>
                <field name="price_subtotal" groups="purchase.group_purchase_user" optional="hide"/>
                <field name="cl_receipt_progress" widget="badge"
                       decoration-warning="cl_receipt_progress == 'part'"
                       decoration-info="cl_receipt_progress == 'none'"/>
                <!-- Standard purchase method: opens the order of the line -->
                <button name="action_open_order" type="object"
                        groups="purchase.group_purchase_user"
                        string="Open Order" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <!-- Product template form -->
    <record id="product_template_form_inherit_cl_incoming" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cl.incoming.purchases</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_cl_view_incoming_po_lines" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        groups="purchase.group_purchase_user,stock.group_stock_user"
                        invisible="not cl_incoming_po_line_count">
                    <field name="cl_incoming_po_line_count" widget="statinfo" string="Incoming"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Incoming Purchases" name="cl_incoming_purchases"
                      groups="purchase.group_purchase_user,stock.group_stock_user"
                      invisible="not cl_incoming_po_line_count">
                    <field name="cl_incoming_po_line_ids" readonly="1" nolabel="1"
                           context="{'list_view_ref': 'cl_product_purchase_lines.cl_incoming_po_line_list'}"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product variant form -->
    <record id="product_normal_form_inherit_cl_incoming" model="ir.ui.view">
        <field name="name">product.product.form.inherit.cl.incoming.purchases</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_cl_view_incoming_po_lines" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        groups="purchase.group_purchase_user,stock.group_stock_user"
                        invisible="not cl_incoming_po_line_count">
                    <field name="cl_incoming_po_line_count" widget="statinfo" string="Incoming"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Incoming Purchases" name="cl_incoming_purchases"
                      groups="purchase.group_purchase_user,stock.group_stock_user"
                      invisible="not cl_incoming_po_line_count">
                    <field name="cl_incoming_po_line_ids" readonly="1" nolabel="1"
                           context="{'list_view_ref': 'cl_product_purchase_lines.cl_incoming_po_line_list'}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
