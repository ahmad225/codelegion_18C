<odoo>
    <template id="report_invoice_document_cl_credit_controller" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" name="cl_credit_controller"
                 t-if="o.company_id.cl_print_credit_controller and o.cl_credit_controller_id and o.move_type in ('out_invoice', 'out_refund', 'out_receipt')">
                <strong>Credit Controller</strong>
                <div t-out="o.cl_credit_controller_id.name"/>
                <div t-if="o.cl_credit_controller_id.email" t-out="o.cl_credit_controller_id.email"/>
            </div>
        </xpath>
    </template>
</odoo>
