<odoo>
    <record id="view_move_form_cl_credit_controller" model="ir.ui.view">
        <field name="name">account.move.form.cl.credit.controller</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="cl_credit_controller_id" widget="many2one_avatar_user"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_cl_credit_controller" model="ir.ui.view">
        <field name="name">account.move.list.cl.credit.controller</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="cl_credit_controller_id" optional="hide" widget="many2one_avatar_user"
                       column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_cl_credit_controller" model="ir.ui.view">
        <field name="name">account.move.search.cl.credit.controller</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="cl_credit_controller_id"/>
            </xpath>
            <xpath expr="//filter[@name='myinvoices']" position="after">
                <filter string="My Invoices to Chase" name="cl_my_invoices_to_chase"
                        domain="[('cl_credit_controller_id', '=', uid),
                                 ('move_type', 'in', ('out_invoice', 'out_receipt')),
                                 ('state', '=', 'posted'),
                                 ('payment_state', 'in', ('not_paid', 'partial')),
                                 ('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
            </xpath>
            <xpath expr="//filter[@name='salesperson']" position="after">
                <filter string="Credit Controller" name="cl_group_credit_controller"
                        context="{'group_by': 'cl_credit_controller_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- The vendor bill search is built from the invoice search: core takes
         "My Invoices" and "Salesperson" out of it, we do the same for ours. -->
    <record id="view_account_bill_filter_cl_credit_controller" model="ir.ui.view">
        <field name="name">account.move.bill.search.cl.credit.controller</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='cl_my_invoices_to_chase']" position="replace"/>
            <xpath expr="//filter[@name='cl_group_credit_controller']" position="replace"/>
        </field>
    </record>
</odoo>
