<odoo>
    <record id="view_picking_type_form_inherit_cl_sign_block" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.cl.sign.block</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_backorder']" position="after">
                <field name="cl_sign_block"/>
            </xpath>
        </field>
    </record>

    <!-- See at a glance which operation types print the block -->
    <record id="view_picking_type_list_inherit_cl_sign_block" model="ir.ui.view">
        <field name="name">stock.picking.type.list.inherit.cl.sign.block</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="cl_sign_block" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
