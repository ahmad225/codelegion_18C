<odoo>
    <record id="cl_hik_device_password_view_form" model="ir.ui.view">
        <field name="name">cl.hik.device.password.form</field>
        <field name="model">cl.hik.device.password</field>
        <field name="arch" type="xml">
            <form string="Set Device Password">
                <p class="text-muted">
                    The password of the device account. It is stored for the sync; only system
                    administrators can read it back. The connection is tested right after.
                </p>
                <group>
                    <field name="device_id" readonly="1"/>
                    <field name="password" password="True"/>
                </group>
                <footer>
                    <button name="action_cl_apply" type="object" string="Save and Test" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
