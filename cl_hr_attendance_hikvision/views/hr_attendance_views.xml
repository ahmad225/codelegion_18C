<odoo>
    <record id="cl_hik_hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.cl.hik</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='check_out_group']" position="after">
                <field name="cl_hik_generated" invisible="1"/>
                <separator string="Hikvision" name="cl_hik_separator" invisible="not cl_hik_generated"
                           groups="hr_attendance.group_hr_attendance_officer"/>
                <group colspan="2" name="cl_hik_group" invisible="not cl_hik_generated"
                       groups="hr_attendance.group_hr_attendance_officer">
                    <group>
                        <field name="cl_hik_missing_checkout"/>
                        <field name="cl_hik_user_edited"/>
                    </group>
                    <field name="cl_hik_punch_ids" colspan="2" nolabel="1">
                        <list>
                            <field name="timestamp"/>
                            <field name="device_id"/>
                            <field name="role"/>
                            <field name="raw_type" optional="hide"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="cl_hik_hr_attendance_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.list.cl.hik</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='out_mode']" position="after">
                <field name="cl_hik_generated" optional="hide"/>
                <field name="cl_hik_missing_checkout" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="cl_hik_hr_attendance_view_filter" model="ir.ui.view">
        <field name="name">hr.attendance.search.cl.hik</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='auto_check']" position="after">
                <filter string="From Hikvision" name="cl_hik_generated" domain="[('cl_hik_generated', '=', True)]"/>
                <filter string="Missing Check-Out" name="cl_hik_missing_checkout"
                        domain="[('cl_hik_missing_checkout', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
