<odoo>
    <record id="cl_hik_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cl.hik</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='overtime_settings']" position="after">
                <block title="Hikvision Devices" name="cl_hik_settings_container">
                    <setting id="cl_hik_sync_interval" string="Download Interval"
                             help="Minutes between two automatic downloads from all Hikvision devices.">
                        <field name="cl_hik_sync_interval" class="text-center" style="width: 6ch;"/>
                        <span class="ms-2">minutes</span>
                        <div class="mt8">
                            <button name="%(cl_hr_attendance_hikvision.cl_hik_device_action)d" type="action"
                                    string="Hikvision Devices" class="btn-link" icon="oi-arrow-right"/>
                        </div>
                    </setting>
                    <setting id="cl_hik_double_swipe" company_dependent="1" string="Double-Swipe Threshold"
                             help="A punch of the same person within this many minutes of the previous one is ignored.">
                        <field name="cl_hik_double_swipe_minutes" class="text-center" style="width: 6ch;"/>
                        <span class="ms-2">minutes</span>
                    </setting>
                    <setting id="cl_hik_max_shift" company_dependent="1" string="Maximum Shift Length"
                             help="A punch is the check-out of the open check-in up to this many hours after it, also across midnight. Longer: the check-in is closed as Missing Check-Out.">
                        <field name="cl_hik_max_shift_hours" class="text-center" style="width: 6ch;"/>
                        <span class="ms-2">hours</span>
                    </setting>
                    <setting id="cl_hik_retention" string="Punch Retention"
                             help="Downloaded punches older than this are deleted; attendances are kept. 0 keeps them forever.">
                        <field name="cl_hik_retention_days" class="text-center" style="width: 6ch;"/>
                        <span class="ms-2">days</span>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
