<odoo>
    <record id="cl_hik_view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.cl.hik</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']/field[@name='pin']" position="after">
                <field name="cl_hik_user_id" groups="hr.group_hr_user" placeholder="Employee No. on the device"/>
            </xpath>
        </field>
    </record>
</odoo>
