<odoo>
    <data noupdate="1">
        <!-- Interval set in Attendances > Configuration > Settings > Hikvision Devices. -->
        <record id="cl_hik_ir_cron_sync" model="ir.cron">
            <field name="name">Hikvision: download punches and update attendances</field>
            <field name="model_id" ref="model_cl_hik_device"/>
            <field name="state">code</field>
            <field name="code">model._cl_cron_sync()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
