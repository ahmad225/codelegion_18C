<odoo>
    <record id="mrp_production_form_inherit_cl_checklist" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.cl.checklist</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']" position="before">
                <!-- Only there when the order has something to check -->
                <page string="Checklist" name="cl_checklist" invisible="not cl_checklist_line_ids">
                    <div class="alert alert-warning" role="alert"
                         invisible="cl_checklist_required_left == 0 or state in ('done', 'cancel')">
                        <field name="cl_checklist_required_left" class="oe_inline fw-bold"/>
                        required item(s) left to tick before this order can be marked as done.
                    </div>
                    <field name="cl_checklist_progress" widget="progressbar" class="mb-2"/>
                    <field name="cl_checklist_line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" no_open="1"
                              decoration-muted="done"
                              decoration-danger="blocking and not done">
                            <field name="done" widget="boolean_toggle"/>
                            <field name="name" readonly="1"/>
                            <field name="guidance" readonly="1" optional="show"/>
                            <field name="blocking" readonly="1" string="Required"/>
                            <field name="done_by_id" optional="show" widget="many2one_avatar_user"/>
                            <field name="done_on" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
