<odoo>
    <record id="cl_customer_statement_log_view_list" model="ir.ui.view">
        <field name="name">cl.customer.statement.log.list</field>
        <field name="model">cl.customer.statement.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="state == 'failed'">
                <field name="create_date" string="Date"/>
                <field name="partner_id"/>
                <field name="statement_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="auto"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'" decoration-danger="state == 'failed'"/>
                <field name="note"/>
                <field name="user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cl_customer_statement_log_view_search" model="ir.ui.view">
        <field name="name">cl.customer.statement.log.search</field>
        <field name="model">cl.customer.statement.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter name="failed" string="Not Sent" domain="[('state', '=', 'failed')]"/>
                <filter name="auto" string="Automatic" domain="[('auto', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Statement" context="{'group_by': 'statement_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cl_customer_statement_log" model="ir.actions.act_window">
        <field name="name">Statements Sent</field>
        <field name="res_model">cl.customer.statement.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="cl_customer_statement_log_view_search"/>
    </record>

    <menuitem id="menu_cl_customer_statement_log"
              name="Statements Sent"
              parent="account.menu_finance_receivables"
              action="action_cl_customer_statement_log"
              sequence="90"/>
</odoo>
