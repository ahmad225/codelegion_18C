<odoo>
    <!-- Runs daily; does nothing unless a company has "Send Monthly Statements" on. -->
    <data noupdate="1">
        <record id="ir_cron_cl_monthly_statements" model="ir.cron">
            <field name="name">Customer Statements: send monthly statements</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_cl_send_monthly_statements()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
