<odoo>
    <record id="cl_customer_statement_wizard_view_form" model="ir.ui.view">
        <field name="name">cl.customer.statement.wizard.form</field>
        <field name="model">cl.customer.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Statements">
                <group>
                    <group>
                        <field name="statement_type" widget="radio"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_from" invisible="statement_type != 'account'"
                               required="statement_type == 'account'"/>
                        <field name="date_to" string="To / As of"/>
                    </group>
                </group>
                <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <p class="text-muted mt-2">
                    Emails go to each customer's Statement Recipients, or to the customer's
                    own email address when none are set. The PDF is attached to the email.
                </p>
                <footer>
                    <button name="action_send" type="object" string="Send by Email" class="btn-primary"/>
                    <button name="action_print" type="object" string="Print" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cl_customer_statement_wizard" model="ir.actions.act_window">
        <field name="name">Customer Statements</field>
        <field name="res_model">cl.customer.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
</odoo>
