<odoo noupdate="1">
    <record id="reminder_stage_company_rule" model="ir.rule">
        <field name="name">Invoice reminder stages: own companies</field>
        <field name="model_id" ref="model_cl_invoice_reminder_stage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="reminder_log_company_rule" model="ir.rule">
        <field name="name">Invoice reminders sent: own companies</field>
        <field name="model_id" ref="model_cl_invoice_reminder_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
