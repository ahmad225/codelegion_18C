<odoo>
    <record id="module_category_cl_courier_cost" model="ir.module.category">
        <field name="name">Courier Cost</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_cl_courier_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_cl_courier_cost"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Sees courier cost logs and reports, enters and locks actual vendor costs, exports and imports vendor sheets.</field>
    </record>

    <record id="group_cl_courier_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_cl_courier_cost"/>
        <field name="implied_ids" eval="[(4, ref('group_cl_courier_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Also manages formulas and variables, unlocks and recomputes courier cost logs.</field>
    </record>

    <record id="rule_cl_courier_cost_company" model="ir.rule">
        <field name="name">Courier cost log: multi-company</field>
        <field name="model_id" ref="model_cl_courier_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cl_courier_formula_company" model="ir.rule">
        <field name="name">Courier formula: multi-company</field>
        <field name="model_id" ref="model_cl_courier_formula"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cl_courier_variable_company" model="ir.rule">
        <field name="name">Courier variable: multi-company</field>
        <field name="model_id" ref="model_cl_courier_variable"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
