<odoo>
    <record id="view_order_form_cl_courier_cost" model="ir.ui.view">
        <field name="name">sale.order.form.cl.courier.cost</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='so_button_below_order_lines']" position="inside">
                <span class="align-self-center text-muted small" name="cl_courier_cost"
                      invisible="not cl_has_courier_formula" groups="cl_courier_cost.group_cl_courier_user">
                    <field name="cl_has_courier_formula" invisible="1"/>
                    <field name="cl_company_currency_id" invisible="1"/>
                    Expected courier cost (internal):
                    <field name="cl_courier_cost_expected" class="oe_inline fw-bold" widget="monetary"
                           options="{'currency_field': 'cl_company_currency_id'}"
                           invisible="cl_courier_cost_message"/>
                    <field name="cl_courier_cost_message" class="oe_inline text-warning"
                           invisible="not cl_courier_cost_message"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
