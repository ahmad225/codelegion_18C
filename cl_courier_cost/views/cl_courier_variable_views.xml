<odoo>
    <record id="cl_courier_variable_view_list" model="ir.ui.view">
        <field name="name">cl.courier.variable.list</field>
        <field name="model">cl.courier.variable</field>
        <field name="arch" type="xml">
            <list string="Courier Variables">
                <field name="cl_code"/>
                <field name="name"/>
                <field name="cl_type"/>
                <field name="cl_fixed_value" invisible="cl_type != 'fixed'"/>
                <field name="cl_source" invisible="cl_type != 'field'"/>
                <field name="cl_expression" invisible="cl_type != 'formula'"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="cl_courier_variable_view_form" model="ir.ui.view">
        <field name="name">cl.courier.variable.form</field>
        <field name="model">cl.courier.variable</field>
        <field name="arch" type="xml">
            <form string="Courier Variable">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Rate per kg"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cl_code" placeholder="e.g. rate_per_kg"/>
                            <field name="cl_type" widget="radio"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="cl_fixed_value" invisible="cl_type != 'fixed'"/>
                            <field name="cl_source" invisible="cl_type != 'field'" required="cl_type == 'field'"/>
                            <field name="cl_expression" invisible="cl_type != 'formula'" required="cl_type == 'formula'"
                                   class="font-monospace" placeholder="e.g. kg * rate_per_kg"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="cl_type != 'field'">
                        On a delivery order the value is read from the validated delivery; on a sales order it
                        is estimated from the order lines (quantities converted to the product's unit).
                        A delivery without packages counts as one package.
                    </div>
                    <field name="cl_description" placeholder="Notes for other managers..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cl_courier_variable_view_search" model="ir.ui.view">
        <field name="name">cl.courier.variable.search</field>
        <field name="model">cl.courier.variable</field>
        <field name="arch" type="xml">
            <search string="Courier Variables">
                <field name="cl_code"/>
                <field name="name"/>
                <filter name="fixed" string="Fixed Values" domain="[('cl_type', '=', 'fixed')]"/>
                <filter name="field" string="Delivery Values" domain="[('cl_type', '=', 'field')]"/>
                <filter name="formula" string="Sub-formulas" domain="[('cl_type', '=', 'formula')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'cl_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cl_courier_variable_action" model="ir.actions.act_window">
        <field name="name">Courier Variables</field>
        <field name="res_model">cl.courier.variable</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a courier cost variable</p>
            <p>Variables are the building blocks of courier formulas: a fixed rate, a value read from the
               delivery (weight, volume, packages...) or a sub-formula of other variables.</p>
        </field>
    </record>
</odoo>
