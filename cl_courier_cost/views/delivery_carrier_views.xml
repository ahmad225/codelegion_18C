<odoo>
    <record id="view_delivery_carrier_form_cl_courier_cost" model="ir.ui.view">
        <field name="name">delivery.carrier.form.cl.courier.cost</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='delivery_details']" position="inside">
                <field name="cl_courier_formula_id" options="{'no_create': True}"
                       groups="cl_courier_cost.group_cl_courier_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
