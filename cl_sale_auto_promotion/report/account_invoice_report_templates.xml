<odoo>
    <template id="cl_report_invoice_document_promotion_savings" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='total']" position="after">
            <p t-if="o.cl_promotion_savings" class="o_cl_promotion_savings text-end text-muted small mb-2">
