<odoo>
    <record id="res_config_settings_view_form_cl_rating" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.cl.product.rating.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='sale_product_catalog_settings']" position="inside">
                <setting id="cl_rating_notification_setting" string="Review Notifications"
                         company_dependent="1"
                         help="Email these people whenever a customer rates or reviews a product of this website's company.">
                    <field name="cl_rating_partner_ids" widget="many2many_tags"
                           placeholder="Who should be notified?"/>
                    <div class="mt-2">
                        <label for="cl_rating_template_id" string="Template" class="o_light_label"/>
                        <field name="cl_rating_template_id" options="{'no_create': True}"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
