<odoo>
    <record id="res_config_settings_view_form_cl_inactivity_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cl.inactivity.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="cl_quotation_inactivity" company_dependent="1"
                         string="Stale Quotation Approval"
                         help="Quotations with no activity for longer than this many days need approval before confirmation (0 = off).">
                    <field name="cl_quotation_inactivity_days"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
