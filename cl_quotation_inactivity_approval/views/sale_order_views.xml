<odoo>
    <record id="view_order_form_cl_inactivity_approval" model="ir.ui.view">
        <field name="name">sale.order.form.cl.inactivity.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][@id='action_confirm']" position="before">
                <button name="action_cl_approve" type="object" string="Approve" class="btn-primary"
                        invisible="cl_approval_state != 'pending'"
                        groups="cl_quotation_inactivity_approval.group_cl_quotation_approver"/>
                <button name="action_cl_reject" type="object" string="Reject"
                        invisible="cl_approval_state != 'pending'"
                        groups="cl_quotation_inactivity_approval.group_cl_quotation_approver"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="cl_approval_state != 'pending'">
                    <strong>Pending approval:</strong> this quotation was inactive for too long.
                    An approver must review it before it can be confirmed; until then only approvers can change it.
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Pending Approval" bg_color="text-bg-warning"
                        invisible="cl_approval_state != 'pending'"/>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="cl_last_activity_date" invisible="state not in ('draft', 'sent')"/>
                <field name="cl_approval_state" invisible="cl_approval_state == 'none'"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_cl_inactivity_approval" model="ir.ui.view">
        <field name="name">sale.order.search.cl.inactivity.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter string="Pending Approval" name="cl_pending_approval"
                        domain="[('cl_approval_state', '=', 'pending')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_cl_quotations_to_approve" model="ir.actions.act_window">
        <field name="name">Quotations to Approve</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="domain">[('cl_approval_state', '=', 'pending')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No quotations waiting for approval.</p>
            <p>Quotations confirmed after too long without activity appear here.</p>
        </field>
    </record>

    <menuitem id="menu_cl_quotations_to_approve"
              name="Quotations to Approve"
              parent="sale.sale_order_menu"
              action="action_cl_quotations_to_approve"
              groups="cl_quotation_inactivity_approval.group_cl_quotation_approver"
              sequence="16"/>
</odoo>
