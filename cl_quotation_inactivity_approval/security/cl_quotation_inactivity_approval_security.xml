<odoo>
    <!-- Its own category, so the standard role dropdown on the user form stays a dropdown. -->
    <record id="module_category_cl_quotation_approval" model="ir.module.category">
        <field name="name">Stale Quotation Approval</field>
        <field name="parent_id" ref="base.module_category_sales"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_cl_quotation_approver" model="res.groups">
        <field name="name">Approve Inactive Quotations</field>
        <field name="category_id" ref="module_category_cl_quotation_approval"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Approves or rejects quotations that were inactive for too long, and confirms them directly.</field>
    </record>
</odoo>
