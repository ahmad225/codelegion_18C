<odoo noupdate="1">
    <!-- noupdate: wording changed by the customer survives module upgrades.
         The template is rendered on the company; the figures come from the
         context (cl_low_stock = header values, cl_low_stock_rows = most urgent
         lines) and the complete list travels as an Excel attachment. -->
    <record id="mail_template_cl_low_stock" model="mail.template">
        <field name="name">Low Stock Alert</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="subject">Low stock: {{ ctx.get('cl_low_stock') and ctx['cl_low_stock']['product_count'] or 0 }} product(s) below minimum - {{ object.name }}</field>
        <field name="email_from">{{ object.email_formatted or user.email_formatted }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333333;max-width:680px;">
    <t t-set="info" t-value="ctx.get('cl_low_stock', {})"/>
    <t t-set="rows" t-value="ctx.get('cl_low_stock_rows', [])"/>
    <p>Hello,</p>
    <p>
        <strong><t t-out="info.get('product_count', 0)"/></strong> product(s) of
        <strong><t t-out="object.name"/></strong> are below their minimum stock
        (<t t-out="info.get('date', '')"/>). The complete list is in the attached Excel file.
    </p>
    <p style="color:#666666;">
        Threshold: <t t-out="info.get('threshold', '')"/><br/>
        Compared quantity: <t t-out="info.get('basis', '')"/><br/>
        Locations: <t t-out="info.get('locations', '')"/>
    </p>
    <t t-if="rows">
        <p><strong>Most urgent</strong></p>
        <table style="border-collapse:collapse;width:100%;font-size:13px;">
            <thead>
                <tr style="background-color:#E7E9ED;">
                    <th style="padding:6px 8px;text-align:left;border:1px solid #D0D4DB;">Product</th>
                    <th style="padding:6px 8px;text-align:left;border:1px solid #D0D4DB;">Location</th>
                    <th style="padding:6px 8px;text-align:right;border:1px solid #D0D4DB;">On Hand</th>
                    <th style="padding:6px 8px;text-align:right;border:1px solid #D0D4DB;">Forecast</th>
                    <th style="padding:6px 8px;text-align:right;border:1px solid #D0D4DB;">Minimum</th>
                    <th style="padding:6px 8px;text-align:right;border:1px solid #D0D4DB;">Missing</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="rows" t-as="row">
                    <td style="padding:6px 8px;border:1px solid #D0D4DB;"><t t-out="row['product']"/></td>
                    <td style="padding:6px 8px;border:1px solid #D0D4DB;"><t t-out="row['location']"/></td>
                    <td style="padding:6px 8px;border:1px solid #D0D4DB;text-align:right;"><t t-out="'%.2f' % row['on_hand']"/></td>
                    <td style="padding:6px 8px;border:1px solid #D0D4DB;text-align:right;"><t t-out="'%.2f' % row['forecast']"/></td>
                    <td style="padding:6px 8px;border:1px solid #D0D4DB;text-align:right;"><t t-out="'%.2f' % row['minimum']"/></td>
                    <td style="padding:6px 8px;border:1px solid #D0D4DB;text-align:right;"><strong><t t-out="'%.2f' % row['shortfall']"/></strong></td>
                </tr>
            </tbody>
        </table>
        <p t-if="info.get('line_count', 0) &gt; len(rows)" style="color:#666666;">
            ... and <t t-out="info.get('line_count', 0) - len(rows)"/> more in the attached file.
        </p>
    </t>
</div>
        </field>
    </record>
</odoo>
