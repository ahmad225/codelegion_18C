<odoo>
    <record id="cl_low_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">cl.low.stock.report.wizard.form</field>
        <field name="model">cl.low.stock.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Low Stock">
                <p class="text-muted">
                    Products that are below their minimum stock right now, as defined in
                    the Inventory settings.
                </p>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"
                               options="{'no_open': True}"/>
                        <field name="source"/>
                        <field name="basis"/>
                    </group>
                    <group>
                        <field name="location_ids" widget="many2many_tags"
                               placeholder="All warehouses"/>
                        <field name="recipient_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_download_xlsx" type="object" string="Download Excel"
                            class="btn-secondary"/>
                    <button name="action_send_now" type="object" string="Send E-mail Now"
                            class="btn-secondary"
                            confirm="Send the low stock e-mail to the recipients now?"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cl_low_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Low Stock</field>
        <field name="res_model">cl.low.stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Inventory > Reporting is for Inventory Administrators, like this report -->
    <menuitem id="menu_cl_low_stock_report"
              name="Low Stock"
              parent="stock.menu_warehouse_report"
              action="action_cl_low_stock_report_wizard"
              groups="stock.group_stock_manager"
              sequence="90"/>
</odoo>
