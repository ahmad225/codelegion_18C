<odoo>
    <record id="cl_res_config_settings_view_form_collection_pin" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.cl.collection.pin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='shipping_setting_container']" position="inside">
                <setting id="cl_collection_pin_attempts" string="Click &amp; Collect PIN"
                         company_dependent="1"
                         help="Wrong PIN entries allowed before a collection PIN is locked. Only an Inventory Administrator can then issue a new PIN. Mark delivery methods as Customer Collection to use PINs.">
                    <div class="content-group mt-2">
                        <label for="cl_pin_max_attempts" string="Attempts"/>
                        <field name="cl_pin_max_attempts" class="oe_inline ms-2"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
