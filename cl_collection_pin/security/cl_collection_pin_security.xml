<odoo>
    <data noupdate="1">
        <record id="cl_rule_collection_pin_log_company" model="ir.rule">
            <field name="name">Collection PIN Log: multi-company</field>
            <field name="model_id" ref="model_cl_collection_pin_log"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('cl_company_id', 'in', company_ids)]</field>
        </record>

        <!-- Same visibility as the sales orders themselves. -->
        <record id="cl_rule_collection_pin_log_salesman" model="ir.rule">
            <field name="name">Collection PIN Log: own orders</field>
            <field name="model_id" ref="model_cl_collection_pin_log"/>
            <field name="domain_force">['|', ('cl_order_id.user_id', '=', user.id), ('cl_order_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="cl_rule_collection_pin_log_all_orders" model="ir.rule">
            <field name="name">Collection PIN Log: all orders</field>
            <field name="model_id" ref="model_cl_collection_pin_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('stock.group_stock_user'))]"/>
        </record>
    </data>
</odoo>
