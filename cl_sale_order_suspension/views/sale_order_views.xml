<odoo>
    <record id="view_order_form_cl_suspension" model="ir.ui.view">
        <field name="name">sale.order.form.cl.suspension</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][@id='action_confirm']" position="before">
                <button name="action_cl_open_suspend_wizard" type="object" string="Suspend"
                        invisible="cl_is_suspended or state not in ('draft', 'sent')"
                        groups="cl_sale_order_suspension.group_cl_sale_suspension"/>
                <button name="action_cl_resume" type="object" string="Resume" class="btn-primary"
                        invisible="not cl_is_suspended"
                        groups="cl_sale_order_suspension.group_cl_sale_suspension"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not cl_is_suspended">
                    <strong>Suspended</strong> by <field name="cl_suspended_by_id" class="oe_inline" readonly="1"/>
                    on <field name="cl_suspended_date" class="oe_inline" readonly="1"/>:
                    <field name="cl_suspension_reason" class="oe_inline" readonly="1"/>
                </div>
                <div class="alert alert-info mb-0 d-flex align-items-center gap-1" role="status"
                     invisible="not cl_other_suspended_order_ids">
                    <span>This customer has other quotations on hold:</span>
                    <field name="cl_other_suspended_order_ids" widget="x2many_buttons"
                           string="Suspended Quotations"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Suspended" bg_color="text-bg-warning" invisible="not cl_is_suspended"/>
                <field name="cl_is_suspended" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_cl_suspension" model="ir.ui.view">
        <field name="name">sale.order.quotation.list.cl.suspension</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="cl_is_suspended" optional="show" widget="boolean_toggle" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_cl_suspension" model="ir.ui.view">
        <field name="name">sale.order.search.cl.suspension</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter string="Suspended" name="cl_suspended" domain="[('cl_is_suspended', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_cl_suspended_quotations" model="ir.actions.act_window">
        <field name="name">Suspended Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="domain">[('cl_is_suspended', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No suspended quotations.</p>
            <p>Use <b>Suspend</b> on a quotation to put it on hold with a reason and a follow-up date.</p>
        </field>
    </record>

    <menuitem id="menu_cl_suspended_quotations"
              name="Suspended Quotations"
              parent="sale.sale_order_menu"
              action="action_cl_suspended_quotations"
              sequence="15"/>
</odoo>
