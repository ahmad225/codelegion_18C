<odoo>
    <record id="cl_sale_suspend_wizard_form" model="ir.ui.view">
        <field name="name">cl.sale.suspend.wizard.form</field>
        <field name="model">cl.sale.suspend.wizard</field>
        <field name="arch" type="xml">
            <form string="Suspend Quotation">
                <field name="order_ids" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is this quotation on hold?"/>
                    <field name="follow_up_date"/>
                </group>
                <footer>
                    <button name="action_suspend" type="object" string="Suspend" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
