<odoo>
    <record id="cl_product_compatibility_group_view_list" model="ir.ui.view">
        <field name="name">cl.product.compatibility.group.list</field>
        <field name="model">cl.product.compatibility.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_count"/>
                <field name="description" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="cl_product_compatibility_group_view_form" model="ir.ui.view">
        <field name="name">cl.product.compatibility.group.form</field>
        <field name="model">cl.product.compatibility.group</field>
        <field name="arch" type="xml">
            <form string="Compatibility Group">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" placeholder="Cups &amp; Lids"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   placeholder="All companies"/>
                            <field name="description" placeholder="What this group is for"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        Two products of this group on the same order are flagged when they do not fit
                        together and neither has a product it fits with elsewhere on the order.
                        Open a product below to set what it fits with.
                    </div>
                    <field name="product_ids" options="{'no_create': True}"
                           domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]">
                        <list>
                            <field name="default_code" optional="show"/>
                            <field name="display_name" string="Product"/>
                            <field name="cl_compatible_product_ids" string="Fits With" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cl_product_compatibility_group_view_search" model="ir.ui.view">
        <field name="name">cl.product.compatibility.group.search</field>
        <field name="model">cl.product.compatibility.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                <field name="product_ids" string="Product"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cl_product_compatibility_group" model="ir.actions.act_window">
        <field name="name">Compatibility Groups</field>
        <field name="res_model">cl.product.compatibility.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No compatibility group yet</p>
            <p>A group holds the products that must be checked against each other on an order,
               for example the cups and the lids. On each product you then say which ones it fits with.</p>
        </field>
    </record>

    <menuitem id="menu_cl_product_compatibility_group"
              name="Compatibility Groups"
              parent="sale.prod_config_main"
              action="action_cl_product_compatibility_group"
              groups="sales_team.group_sale_manager"
              sequence="40"/>
</odoo>
