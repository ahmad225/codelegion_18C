<odoo>
    <record id="view_order_form_inherit_cl_compatibility" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cl.compatibility</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_cl_override_compatibility" type="object"
                        string="Confirm Despite Mismatch"
                        groups="sales_team.group_sale_manager"
                        confirm="Confirm this order even though some products are not compatible? The override is logged."
                        invisible="not cl_compatibility_warning or state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not cl_compatibility_warning">
                    <strong>Product compatibility:</strong>
                    <field name="cl_compatibility_warning" class="d-block" style="white-space: pre-line;"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
