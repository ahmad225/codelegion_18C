<odoo>
    <!-- Full variant form (Sales > Products > Product Variants) -->
    <record id="product_normal_form_inherit_cl_compatibility" model="ir.ui.view">
        <field name="name">product.product.form.inherit.cl.compatibility</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='extra_info']" position="after">
                <group name="cl_compatibility" string="Sold Together">
                    <field name="cl_compatibility_group_ids" string="Checked In" widget="many2many_tags"
                           options="{'no_create': True, 'color_field': 'color'}"/>
                    <field name="cl_compatible_product_ids" string="Fits With" widget="many2many_tags"
                           options="{'no_create': True}"
                           invisible="not cl_compatibility_group_ids"
                           domain="[('cl_compatibility_group_ids', 'in', cl_compatibility_group_ids), ('id', '!=', id)]"/>
                    <div class="text-muted small" colspan="2" invisible="cl_compatibility_group_ids">
                        Add the product to a compatibility group to check it against the other products of that group on orders.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Short variant form opened from the "Variants" button of a product -->
    <record id="product_variant_easy_edit_view_inherit_cl_compatibility" model="ir.ui.view">
        <field name="name">product.product.easy.form.inherit.cl.compatibility</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales']" position="inside">
                <field name="cl_compatibility_group_ids" string="Checked In" widget="many2many_tags"
                       options="{'no_create': True, 'color_field': 'color'}"/>
                <field name="cl_compatible_product_ids" string="Fits With" widget="many2many_tags"
                       options="{'no_create': True}"
                       invisible="not cl_compatibility_group_ids"
                       domain="[('cl_compatibility_group_ids', 'in', cl_compatibility_group_ids), ('id', '!=', id)]"/>
            </xpath>
        </field>
    </record>

    <!-- Product form: only meaningful while the product has a single variant -->
    <record id="product_template_form_inherit_cl_compatibility" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cl.compatibility</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='extra_info']" position="after">
                <group name="cl_compatibility" string="Sold Together">
                    <field name="cl_compatibility_group_ids" string="Checked In" widget="many2many_tags"
                           options="{'no_create': True, 'color_field': 'color'}"
                           invisible="product_variant_count &gt; 1"/>
                    <field name="cl_compatible_product_ids" string="Fits With" widget="many2many_tags"
                           options="{'no_create': True}"
                           invisible="product_variant_count &gt; 1 or not cl_compatibility_group_ids"
                           domain="[('cl_compatibility_group_ids', 'in', cl_compatibility_group_ids), ('product_tmpl_id', '!=', id)]"/>
                    <div class="text-muted small" colspan="2" invisible="product_variant_count &lt;= 1">
                        This product has several variants: set what each one fits with from the Variants button.
                    </div>
                    <div class="text-muted small" colspan="2"
                         invisible="product_variant_count &gt; 1 or cl_compatibility_group_ids">
                        Add the product to a compatibility group to check it against the other products of that group on orders.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
