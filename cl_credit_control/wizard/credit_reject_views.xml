<odoo>
    <record id="view_cl_credit_reject_form" model="ir.ui.view">
        <field name="name">cl.credit.reject.form</field>
        <field name="model">cl.credit.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Credit Request">
                <group>
                    <field name="order_id"/>
                    <field name="reason" placeholder="Tell the salesperson why, and what would change the decision"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cl_credit_reject" model="ir.actions.act_window">
        <field name="name">Reject Credit Request</field>
        <field name="res_model">cl.credit.reject</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
