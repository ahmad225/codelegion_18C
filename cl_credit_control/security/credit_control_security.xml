<odoo>
    <!-- Its own category, so the standard Sales and Accounting role selectors are left alone -->
    <record id="module_category_cl_credit_control" model="ir.module.category">
        <field name="name">Credit Control</field>
        <field name="description">Who may approve or reject blocked quotations.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_cl_credit_manager" model="res.groups">
        <field name="name">Credit Manager</field>
        <field name="category_id" ref="module_category_cl_credit_control"/>
        <!-- "All Documents": a Credit Manager decides on other salespeople's quotations,
             which "Own Documents Only" would hide from them -->
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="comment">Can approve or reject quotations blocked by credit control, and set credit hold, exemption and overdue allowance on customers.</field>
    </record>
</odoo>
