<odoo>
    <record id="view_order_form_cl_credit_control" model="ir.ui.view">
        <field name="name">sale.order.form.cl.credit.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Credit Manager buttons, only while a request is waiting -->
            <xpath expr="//header/button[@id='action_confirm']" position="before">
                <button name="action_cl_credit_approve" type="object"
                        string="Approve Credit" class="btn-primary"
                        groups="cl_credit_control.group_cl_credit_manager"
                        invisible="cl_credit_state != 'to_approve' or state not in ('draft', 'sent')"
                        confirm="Approve this credit exception and confirm the quotation?"/>
                <button name="action_cl_credit_reject" type="object"
                        string="Reject Credit"
                        groups="cl_credit_control.group_cl_credit_manager"
                        invisible="cl_credit_state != 'to_approve' or state not in ('draft', 'sent')"/>
                <!-- Ask for approval without having to click Confirm first -->
                <button name="action_cl_credit_review" type="object"
                        string="Request Credit Approval"
                        invisible="not cl_credit_warning or cl_credit_state == 'to_approve' or state not in ('draft', 'sent')"/>
            </xpath>

            <!-- Why the quotation is blocked, and where the request stands -->
            <xpath expr="//sheet" position="before">
                <field name="cl_credit_state" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="not cl_credit_warning or cl_credit_state in ('to_approve', 'rejected')">
                    <strong>Credit approval needed to confirm.</strong>
                    <field name="cl_credit_warning" class="d-block"/>
                </div>
                <div class="alert alert-info mb-0" role="alert"
                     invisible="cl_credit_state != 'to_approve' or state not in ('draft', 'sent')">
                    <strong>Waiting for credit approval.</strong>
                    <field name="cl_credit_warning" class="d-block"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="cl_credit_state != 'rejected' or state not in ('draft', 'sent')">
                    <strong>Credit request rejected:</strong>
                    <field name="cl_credit_reject_reason" class="d-block"/>
                </div>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Credit Approval" name="cl_credit_approval"
                       invisible="not cl_credit_state">
                    <group>
                        <field name="cl_credit_state" widget="badge"
                               decoration-info="cl_credit_state == 'to_approve'"
                               decoration-success="cl_credit_state == 'approved'"
                               decoration-danger="cl_credit_state == 'rejected'"/>
                        <field name="cl_credit_requested_by_id"/>
                        <field name="cl_credit_requested_on"/>
                        <field name="cl_credit_request_note" invisible="not cl_credit_request_note"/>
                    </group>
                    <group>
                        <field name="cl_credit_decided_by_id"/>
                        <field name="cl_credit_decided_on"/>
                        <field name="cl_credit_approved_amount" invisible="cl_credit_state != 'approved'"/>
                        <field name="cl_credit_reject_reason" invisible="cl_credit_state != 'rejected'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_cl_credit_control" model="ir.ui.view">
        <field name="name">sale.order.search.cl.credit.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter string="Waiting Credit Approval" name="cl_credit_to_approve"
                        domain="[('cl_credit_state', '=', 'to_approve')]"/>
                <filter string="Credit Rejected" name="cl_credit_rejected"
                        domain="[('cl_credit_state', '=', 'rejected')]"/>
            </xpath>
        </field>
    </record>

    <!-- Work list for Credit Managers -->
    <record id="action_cl_credit_approvals" model="ir.actions.act_window">
        <field name="name">Credit Approvals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cl_credit_state', '=', 'to_approve'), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No quotation is waiting for credit approval</p>
            <p>Quotations blocked by credit control appear here once the salesperson asks for approval.</p>
        </field>
    </record>

    <menuitem id="menu_cl_credit_approvals"
              name="Credit Approvals"
              parent="sale.sale_order_menu"
              action="action_cl_credit_approvals"
              groups="cl_credit_control.group_cl_credit_manager"
              sequence="25"/>
</odoo>
