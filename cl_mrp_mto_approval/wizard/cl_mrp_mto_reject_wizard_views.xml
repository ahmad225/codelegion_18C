<odoo>
    <record id="cl_mrp_mto_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">cl.mrp.mto.reject.wizard.form</field>
        <field name="model">cl.mrp.mto.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Manufacturing Order">
                <group>
                    <field name="production_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                    <field name="reason" placeholder="Why can this order not be produced as it is?"/>
                    <field name="cancel_production"/>
                </group>
                <p class="text-muted">
                    The salesperson of the sales order is notified with this reason.
                    Sub-assembly orders and backorders of this order are rejected with it.
                </p>
                <footer>
                    <button name="action_cl_confirm_reject" type="object" string="Reject" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
