<odoo>
    <!-- Manufacturing users already have sale_mrp's own Manufacturing button. -->
    <record id="view_order_form_cl_mto_approval" model="ir.ui.view">
        <field name="name">sale.order.form.cl.mto.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_cl_view_mto_productions" type="object" icon="fa-wrench"
                        invisible="cl_mrp_production_count == 0"
                        groups="cl_mrp_mto_approval.group_cl_mto_sale_viewer,!mrp.group_mrp_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="cl_mrp_production_count"/></span>
                        <span class="o_stat_text">Manufacturing</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
