<odoo>
    <!-- Its own category, so the standard Manufacturing and Sales role dropdowns on the user form stay dropdowns. -->
    <record id="module_category_cl_mto_approval" model="ir.module.category">
        <field name="name">Make-to-Order Approval</field>
        <field name="parent_id" ref="base.module_category_manufacturing"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_cl_mto_coordinator" model="res.groups">
        <field name="name">Manufacturing Coordinator</field>
        <field name="category_id" ref="module_category_cl_mto_approval"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Approves or rejects manufacturing orders created from sales orders (make-to-order) and receives the approval activities. Administrators can approve too.</field>
    </record>

    <record id="group_cl_mto_sale_viewer" model="res.groups">
        <field name="name">See Manufacturing of Sales Orders (read-only)</field>
        <field name="category_id" ref="module_category_cl_mto_approval"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Salespeople get a Manufacturing button on the sales orders they can open (only their own orders with "Own Documents Only") and see the manufacturing and work orders of that order, read-only. Manufacturing users keep their full access.</field>
    </record>

    <!--
        Record rules. Rules of a user's groups are combined with OR, so:
        * viewers can never write, create or delete manufacturing orders and work orders
          (Odoo's sale_mrp gives every salesperson those rights; the Manufacturing button
          must not become a way to edit production);
        * manufacturing users get an explicit "all" rule for the same operations, so a
          person who is both a viewer and a manufacturing user keeps the access of that role.
        Reading is deliberately not restricted: Odoo already lets every salesperson read
        manufacturing orders, and screens they use (the Forecast report opened from a sales
        order line) read the names of all manufacturing orders of a product, so a read
        restriction would break them with an access error. Which orders a viewer reaches is
        decided by the sales orders they can open.
        Other users are not affected: these rules only apply to the groups listed.
    -->
    <record id="rule_cl_mto_viewer_production_no_write" model="ir.rule">
        <field name="name">MTO viewer: manufacturing orders are read-only</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cl_mto_sale_viewer'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_cl_mto_mrp_user_production_all" model="ir.rule">
        <field name="name">MTO approval: manufacturing users keep editing all manufacturing orders</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_cl_mto_viewer_workorder_no_write" model="ir.rule">
        <field name="name">MTO viewer: work orders are read-only</field>
        <field name="model_id" ref="mrp.model_mrp_workorder"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cl_mto_sale_viewer'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_cl_mto_mrp_user_workorder_all" model="ir.rule">
        <field name="name">MTO approval: manufacturing users keep editing all work orders</field>
        <field name="model_id" ref="mrp.model_mrp_workorder"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
