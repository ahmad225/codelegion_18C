<odoo>
    <!-- Chart of Accounts list: archived rows greyed out, plus an "Archived"
         column. The column is read-only on purpose: the list is editable and
         one stray click must not archive an account (use the Actions menu). -->
    <record id="cl_account_account_view_list" model="ir.ui.view">
        <field name="name">cl.account.account.list.archive</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="/list" position="attributes">
                <attribute name="decoration-muted">deprecated</attribute>
            </xpath>
            <xpath expr="/list" position="inside">
                <field name="deprecated" string="Archived" widget="boolean_toggle"
                       readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Account form: the standard "Archived" ribbon, and the core Deprecated
         checkbox shown as an "Archived" toggle. -->
    <record id="cl_account_account_view_form" model="ir.ui.view">
        <field name="name">cl.account.account.form.archive</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <div name="button_box" position="after">
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="not deprecated"/>
            </div>
            <field name="deprecated" position="attributes">
                <attribute name="string">Archived</attribute>
                <attribute name="widget">boolean_toggle</attribute>
            </field>
        </field>
    </record>

    <!-- Search: an "Archived" filter beside the core "Active Account" one. -->
    <record id="cl_account_account_view_search" model="ir.ui.view">
        <field name="name">cl.account.account.search.archive</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <filter name="activeacc" position="after">
                <filter string="Archived" name="cl_archived_accounts"
                        domain="[('deprecated', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
