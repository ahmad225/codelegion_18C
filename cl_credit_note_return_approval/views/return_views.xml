<odoo>
    <!-- ============ Credit note reasons ============ -->
    <record id="credit_reason_view_list" model="ir.ui.view">
        <field name="name">cl.credit.note.reason.list</field>
        <field name="model">cl.credit.note.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="requires_return"/>
                <field name="company_id" groups="base.group_multi_company"
                       options="{'no_create': True}" placeholder="All companies"/>
            </list>
        </field>
    </record>

    <record id="credit_reason_view_search" model="ir.ui.view">
        <field name="name">cl.credit.note.reason.search</field>
        <field name="model">cl.credit.note.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="with_return" string="Goods Must Come Back"
                        domain="[('requires_return', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_credit_reason" model="ir.actions.act_window">
        <field name="name">Credit Note Reasons</field>
        <field name="res_model">cl.credit.note.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a reason for crediting customers
            </p>
            <p>
                Tick "Goods Must Come Back" on the reasons that involve a return: those
                credit notes can only be posted after a return request was approved and
                the goods were received.
            </p>
        </field>
    </record>

    <!-- ============ Return requests ============ -->
    <record id="return_request_view_form" model="ir.ui.view">
        <field name="name">cl.return.request.form</field>
        <field name="model">cl.return.request</field>
        <field name="arch" type="xml">
            <form create="0" duplicate="0">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'to_approve'"
                            groups="cl_credit_note_return_approval.group_cl_return_approver"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'to_approve'"
                            confirm="Reject this return? The credit note cannot be posted with its current reason."
                            groups="cl_credit_note_return_approval.group_cl_return_approver"/>
                    <button name="action_cancel" type="object" string="Cancel Request"
                            invisible="state not in ('to_approve', 'approved') or is_received"
                            confirm="Cancel this request? Return transfers that are not received yet are cancelled too."
                            groups="account.group_account_invoice"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0"
                                groups="stock.group_stock_user">
                            <field name="picking_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Received" invisible="not is_received"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="credit_note_id" readonly="1"/>
                            <field name="invoice_id"/>
                            <field name="reason_id"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="decided_by_id" widget="many2one_avatar_user"
                                   invisible="not decided_by_id"/>
                            <field name="decided_on" invisible="not decided_on"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_received" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Goods To Return" name="lines">
                            <field name="line_ids" readonly="state != 'to_approve'">
                                <list editable="bottom" create="0">
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                </list>
                            </field>
                            <p class="text-muted" invisible="state != 'to_approve'">
                                Approving creates the return transfers from the deliveries of
                                the invoice, for these quantities at most.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="return_request_view_list" model="ir.ui.view">
        <field name="name">cl.return.request.list</field>
        <field name="model">cl.return.request</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'to_approve'"
                  decoration-muted="state in ('rejected', 'cancel')">
                <field name="name"/>
                <field name="create_date" string="Requested On" widget="date"/>
                <field name="partner_id"/>
                <field name="credit_note_id"/>
                <field name="reason_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="is_received" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="return_request_view_search" model="ir.ui.view">
        <field name="name">cl.return.request.search</field>
        <field name="model">cl.return.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id" operator="child_of"/>
                <field name="credit_note_id"/>
                <field name="reason_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="mine" string="My Requests" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_reason" string="Reason" context="{'group_by': 'reason_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_return_request" model="ir.actions.act_window">
        <field name="name">Return Requests</field>
        <field name="res_model">cl.return.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No return request yet
            </p>
            <p>
                A return is requested from a draft credit note whose reason requires the
                goods to come back.
            </p>
        </field>
    </record>

    <record id="action_return_request_to_approve" model="ir.actions.act_window">
        <field name="name">Returns To Approve</field>
        <field name="res_model">cl.return.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No return is waiting for your decision
            </p>
        </field>
    </record>

    <!-- ============ Credit note ============ -->
    <record id="view_move_form_goods_return" model="ir.ui.view">
        <field name="name">account.move.form.cl.goods.return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_cl_request_return" type="object" string="Request Return"
                        class="btn-primary"
                        invisible="move_type != 'out_refund' or state != 'draft' or cl_return_status not in ('to_request', 'rejected')"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_cl_view_return_requests" type="object"
                        class="oe_stat_button" icon="fa-reply"
                        invisible="cl_return_request_count == 0">
                    <field name="cl_return_request_count" widget="statinfo" string="Returns"/>
                </button>
            </div>
            <group id="header_right_group" position="inside">
                <field name="cl_credit_reason_id" invisible="move_type != 'out_refund'"
                       readonly="state != 'draft'" options="{'no_create': True}"/>
                <field name="cl_return_status" widget="badge"
                       invisible="move_type != 'out_refund' or not cl_return_status"
                       decoration-warning="cl_return_status in ('to_request', 'to_approve', 'to_receive')"
                       decoration-success="cl_return_status == 'received'"
                       decoration-danger="cl_return_status == 'rejected'"/>
            </group>
        </field>
    </record>

    <record id="view_account_move_reversal_credit_reason" model="ir.ui.view">
        <field name="name">account.move.reversal.form.cl.credit.reason</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <field name="reason" position="before">
                <field name="cl_requires_return" invisible="1"/>
                <field name="cl_credit_reason_id"
                       invisible="move_type != 'out_invoice'"
                       required="move_type == 'out_invoice'"
                       options="{'no_create': True, 'no_open': True}"/>
            </field>
            <xpath expr="//footer" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="not cl_requires_return">
                    With this reason the goods must come back. The credit note stays a
                    draft until its return request is approved and the goods are received.
                </div>
            </xpath>
            <!-- crediting and re-invoicing in one go would post the credit note at once -->
            <button name="modify_moves" position="attributes">
                <attribute name="invisible">move_type == 'entry' or cl_requires_return</attribute>
            </button>
        </field>
    </record>

    <!-- ============ Return transfer ============ -->
    <record id="view_picking_form_return_request" model="ir.ui.view">
        <field name="name">stock.picking.form.cl.return.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="cl_return_request_id" invisible="not cl_return_request_id"/>
            </xpath>
        </field>
    </record>

    <!-- ============ Analysis ============ -->
    <record id="return_analysis_view_pivot" model="ir.ui.view">
        <field name="name">cl.return.analysis.pivot</field>
        <field name="model">cl.return.analysis</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="product_categ_id" type="row"/>
                <field name="reason_id" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="return_analysis_view_graph" model="ir.ui.view">
        <field name="name">cl.return.analysis.graph</field>
        <field name="model">cl.return.analysis</field>
        <field name="arch" type="xml">
            <graph type="line" sample="1">
                <field name="date" interval="month"/>
                <field name="reason_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="return_analysis_view_list" model="ir.ui.view">
        <field name="name">cl.return.analysis.list</field>
        <field name="model">cl.return.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="request_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="reason_id"/>
                <field name="credit_note_id" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="return_analysis_view_search" model="ir.ui.view">
        <field name="name">cl.return.analysis.search</field>
        <field name="model">cl.return.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="product_categ_id"/>
                <field name="partner_id" operator="child_of"/>
                <field name="reason_id"/>
                <field name="user_id"/>
                <filter name="date" string="Received On" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="by_reason" string="Reason" context="{'group_by': 'reason_id'}"/>
                    <filter name="by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="by_category" string="Product Category" context="{'group_by': 'product_categ_id'}"/>
                    <filter name="by_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="by_month" string="Month Received" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_return_analysis" model="ir.actions.act_window">
        <field name="name">Returned Goods</field>
        <field name="res_model">cl.return.analysis</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="return_analysis_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Nothing has been returned yet
            </p>
            <p>
                Goods received back through approved return requests, valued at the
                price their credit note gives for them.
            </p>
        </field>
    </record>

    <!-- ============ Menus ============ -->
    <menuitem id="menu_return_request"
              name="Return Requests"
              parent="account.menu_finance_receivables"
              action="action_return_request"
              sequence="25"/>
    <menuitem id="menu_credit_reason"
              name="Credit Note Reasons"
              parent="account.account_invoicing_menu"
              action="action_credit_reason"
              groups="account.group_account_manager"
              sequence="60"/>
    <menuitem id="menu_return_analysis"
              name="Returned Goods"
              parent="account.account_reports_management_menu"
              action="action_return_analysis"
              sequence="60"/>
    <menuitem id="menu_return_request_to_approve"
              name="Returns To Approve"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_return_request_to_approve"
              groups="group_cl_return_approver"
              sequence="90"/>
</odoo>
