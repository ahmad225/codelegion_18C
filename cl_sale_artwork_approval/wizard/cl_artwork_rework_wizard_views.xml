<odoo>
    <record id="cl_artwork_rework_wizard_view_form" model="ir.ui.view">
        <field name="name">cl.artwork.rework.wizard.form</field>
        <field name="model">cl.artwork.rework.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Rework">
                <field name="cl_artwork_id" invisible="1"/>
                <p class="text-muted">The designer gets a new activity with your comment.</p>
                <field name="cl_comment" nolabel="1" placeholder="e.g. Make the logo 20% smaller and use the dark blue from the brand guide."/>
                <footer>
                    <button name="action_cl_confirm" type="object" string="Request Rework" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
