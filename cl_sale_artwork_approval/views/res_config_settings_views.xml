<odoo>
    <record id="res_config_settings_view_form_cl_artwork" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cl.artwork</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Customer Artwork" name="cl_artwork_setting_container">
                    <setting id="cl_artwork_block_sale" company_dependent="1"
                             help="Staff cannot confirm a quotation until the artwork of every product marked 'Requires Artwork' is approved.">
                        <field name="cl_artwork_block_sale"/>
                    </setting>
                    <setting id="cl_artwork_block_production" company_dependent="1"
                             help="Manufacturing orders made for a sales order cannot be started or produced until their artwork is approved.">
                        <field name="cl_artwork_block_production"/>
                    </setting>
                    <setting id="cl_artwork_attach_production" company_dependent="1"
                             help="Attach a copy of the approved proof to manufacturing orders. The copy can be opened by everyone who can open the manufacturing order.">
                        <field name="cl_artwork_attach_production"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
