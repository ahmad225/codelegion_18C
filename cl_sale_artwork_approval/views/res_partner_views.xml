<odoo>
    <record id="view_partner_form_cl_artwork" model="ir.ui.view">
        <field name="name">res.partner.form.cl.artwork</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_cl_view_artworks" type="object" class="oe_stat_button"
                        icon="fa-paint-brush" invisible="cl_artwork_count == 0"
                        groups="sales_team.group_sale_salesman,mrp.group_mrp_user,cl_sale_artwork_approval.group_cl_artwork_designer">
                    <field name="cl_artwork_count" widget="statinfo" string="Artworks"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
