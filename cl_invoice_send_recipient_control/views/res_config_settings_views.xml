<odoo>
    <!-- One switch in the existing "Customer Invoices" section of the Invoicing settings. -->
    <record id="res_config_settings_view_form_cl_invoice_recipient" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.cl.invoice.send.recipient</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="cl_invoice_email_skip_followers_setting"
                         string="Invoice Emails: Skip Followers"
                         company_dependent="1"
                         help="Invoices sent by email reach only the recipients listed when sending (the customer and anyone you add). Followers of the invoice do not get a copy. Messages written in the chatter still notify followers.">
                    <field name="cl_invoice_email_skip_followers"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
