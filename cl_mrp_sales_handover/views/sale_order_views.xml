<odoo>
    <record id="view_order_form_cl_handover" model="ir.ui.view">
        <field name="name">sale.order.form.cl.handover</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not cl_event_at_risk">
                    <strong>Event at risk:</strong> manufacturing is expected to finish after the customer's event date.
                </div>
                <div class="alert alert-success mb-0" role="status"
                     invisible="cl_handover_state != 'done' or delivery_status == 'full'">
                    <strong>Ready for delivery:</strong> all manufacturing orders have been handed over to the warehouse.
                </div>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="cl_handover_event_enabled" invisible="1"/>
                <field name="cl_event_at_risk" invisible="1"/>
                <field name="delivery_status" invisible="1"/>
                <field name="cl_event_date" invisible="not cl_handover_event_enabled"
                       readonly="state == 'cancel'"
                       decoration-danger="cl_event_at_risk"/>
                <field name="cl_event_note" invisible="not cl_handover_event_enabled or not cl_event_date"
                       readonly="state == 'cancel'" placeholder="e.g. Wedding, trade fair"/>
            </xpath>
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <field name="cl_mfg_finish_date" invisible="not cl_mfg_finish_date"/>
                <field name="cl_handover_state" invisible="not cl_handover_state"/>
                <field name="cl_commitment_by_mfg" invisible="not cl_commitment_by_mfg"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_cl_handover" model="ir.ui.view">
        <field name="name">sale.order.list.cl.handover</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='commitment_date']" position="after">
                <field name="cl_event_date" optional="hide"/>
                <field name="cl_handover_state" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_cl_handover" model="ir.ui.view">
        <field name="name">sale.order.search.cl.handover</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter string="Ready for Delivery" name="cl_ready_for_delivery"
                        domain="[('cl_handover_state', '=', 'done'), ('delivery_status', '!=', 'full')]"/>
                <filter string="With Event Date" name="cl_with_event_date"
                        domain="[('cl_event_date', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_cl_orders_ready_for_delivery" model="ir.actions.act_window">
        <field name="name">Ready for Delivery</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="view_id" ref="sale.view_order_tree"/>
        <field name="domain">[('cl_handover_state', '=', 'done'), ('delivery_status', '!=', 'full'), ('state', '=', 'sale')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders waiting for delivery.</p>
            <p>Orders appear here once all their manufacturing orders are handed over to the warehouse, until they are delivered or collected.</p>
        </field>
    </record>

    <menuitem id="menu_cl_orders_ready_for_delivery"
              name="Ready for Delivery"
              parent="sale.sale_order_menu"
              action="action_cl_orders_ready_for_delivery"
              groups="sales_team.group_sale_salesman"
              sequence="25"/>
</odoo>
