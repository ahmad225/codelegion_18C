<odoo>
    <!-- Its own category, so the standard role dropdown on the user form stays a dropdown. -->
    <record id="module_category_cl_po_line_control" model="ir.module.category">
        <field name="name">Purchase Line Deletion</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_cl_po_line_delete" model="res.groups">
        <field name="name">Delete Confirmed Purchase Lines</field>
        <field name="category_id" ref="module_category_cl_po_line_control"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Can delete lines of confirmed purchase orders that have not been received or billed.</field>
    </record>
</odoo>
