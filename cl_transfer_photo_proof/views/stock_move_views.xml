<odoo>
    <!-- Dialog opened by the camera button of a line in the transfer's Operations tab. -->
    <record id="view_move_form_cl_photo_proof" model="ir.ui.view">
        <field name="name">stock.move.form.cl.photo.proof</field>
        <field name="model">stock.move</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form string="Photo Proof" create="0" delete="0">
                <field name="state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="product_id" readonly="1" options="{'no_open': True}"/>
                        <field name="picking_id" readonly="1" options="{'no_open': True}"/>
                    </group>
                    <group>
                        <label for="quantity"/>
                        <div class="o_row">
                            <field name="quantity" readonly="1" nolabel="1"/>
                            <field name="product_uom" readonly="1" nolabel="1" options="{'no_open': True}" groups="uom.group_uom"/>
                        </div>
                    </group>
                </group>
                <p class="text-muted" invisible="state in ('done', 'cancel')">
                    Take a picture or add photos or PDF files showing this product.
                </p>
                <field name="cl_proof_attachment_ids" widget="many2many_binary"
                       options="{'accepted_file_extensions': 'image/*,.pdf'}"
                       readonly="state in ('done', 'cancel')"/>
                <footer>
                    <button string="Save" special="save" class="btn-primary" data-hotkey="q"
                            invisible="state in ('done', 'cancel')"/>
                    <button string="Close" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Detailed Operations dialog, also what a phone opens when a line card is tapped. -->
    <record id="view_stock_move_operations_cl_photo_proof" model="ir.ui.view">
        <field name="name">stock.move.operations.form.cl.photo.proof</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_line_ids']" position="after">
                <field name="cl_require_photo_proof" invisible="1"/>
                <div class="mt-3" invisible="not cl_require_photo_proof">
                    <label for="cl_proof_attachment_ids" class="fw-bold"/>
                    <field name="cl_proof_attachment_ids" widget="many2many_binary"
                           options="{'accepted_file_extensions': 'image/*,.pdf'}"
                           readonly="state in ('done', 'cancel')"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
