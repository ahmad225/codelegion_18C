<odoo noupdate="1">
    <!-- Its own activity type, so that closing a margin request never touches
         the other to-dos planned on the order -->
    <record id="mail_activity_type_margin_approval" model="mail.activity.type">
        <field name="name">Margin Approval</field>
        <field name="summary">Approve or reject the order margin</field>
        <field name="icon">fa-percent</field>
        <field name="res_model">sale.order</field>
        <field name="delay_count">0</field>
        <field name="sequence">91</field>
    </record>
</odoo>
