<odoo>
    <record id="view_order_form_inherit_cl_margin" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cl.margin.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Approve / reject buttons, in front of Confirm (also checked on the server) -->
            <xpath expr="//header/button[@id='action_confirm']" position="before">
                <button name="action_cl_margin_approve" type="object" string="Approve Margin"
                        class="btn-primary"
                        invisible="cl_margin_approval_state != 'to_approve' or not cl_margin_can_approve or state not in ('draft', 'sent')"
                        confirm="Approve this margin and confirm the quotation?"/>
                <button name="action_cl_margin_reject" type="object" string="Reject Margin"
                        invisible="cl_margin_approval_state != 'to_approve' or not cl_margin_can_approve or state not in ('draft', 'sent')"/>
            </xpath>

            <!-- Banners, above the sheet where they are seen -->
            <xpath expr="//sheet" position="before">
                <field name="cl_margin_approval_state" invisible="1"/>
                <field name="cl_margin_can_approve" invisible="1"/>
                <field name="cl_margin_order_low" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="cl_margin_approval_state != 'to_approve' or state not in ('draft', 'sent')">
                    <strong>Waiting for margin approval.</strong>
                    This order is below the margin floor and cannot be
                    confirmed until a margin approver approves it.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not cl_margin_order_low or cl_margin_approval_state == 'to_approve' or state not in ('draft', 'sent')">
                    The overall margin on this order is low.
                </div>
            </xpath>

            <!-- Line margin column: shown by default, low margins highlighted -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="cl_margin_low" column_invisible="1"/>
                <field name="cl_margin_pct" string="Margin %" optional="show"
                       decoration-warning="cl_margin_low"
                       decoration-bf="cl_margin_low"
                       invisible="display_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_cl_margin" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.cl.margin.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter string="Waiting Margin Approval" name="cl_margin_to_approve"
                        domain="[('cl_margin_approval_state', '=', 'to_approve')]"/>
            </xpath>
        </field>
    </record>

    <!-- Work list for the margin approvers -->
    <record id="action_cl_margin_approvals" model="ir.actions.act_window">
        <field name="name">Margin Approvals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cl_margin_approval_state', '=', 'to_approve'), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No quotation is waiting for margin approval</p>
            <p>Quotations below the margin floor appear here when someone tries to confirm them.</p>
        </field>
    </record>

    <menuitem id="menu_cl_margin_approvals"
              name="Margin Approvals"
              parent="sale.sale_order_menu"
              action="action_cl_margin_approvals"
              sequence="26"/>
</odoo>
