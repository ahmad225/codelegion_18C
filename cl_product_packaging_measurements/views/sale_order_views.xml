<odoo>
    <!-- Two optional columns next to the Packaging column of the order lines;
         like that column, they need the Product Packagings option. -->
    <record id="view_order_form_inherit_cl_packaging" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cl.packaging.measurements</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_id']" position="after">
                <field name="cl_packaging_dimensions" optional="hide"
                       groups="product.group_stock_packaging"/>
                <field name="cl_packaging_weight" optional="hide"
                       groups="product.group_stock_packaging"/>
            </xpath>
        </field>
    </record>
</odoo>
